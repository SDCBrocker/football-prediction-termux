# API Configuration
API_KEY=your_openfootapi_key_here
API_BASE_URL=https://api.openfootapi.com/v1

# Liga & musim
LEAGUES=EPL,LaLiga,SerieA,Bundesliga,Ligue1,Eredivisie,PrimeiraLiga,Championship,LigaMX,Brasileirao
SEASONS=2023,2024,2025

# O/U fleksibel
OU_LINES=1.5,2.5,3.5

# Prediksi
MIN_CONFIDENCE=0.70
MIN_VALUE=0.05
MAX_LEGS=3
STAKE_PERCENT=0.01

# Telegram
TELEGRAM_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database
DB_PATH=data/processed/matches_normalized.csv
CACHE_DIR=data/raw/cache
